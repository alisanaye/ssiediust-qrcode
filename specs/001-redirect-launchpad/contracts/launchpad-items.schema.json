{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LaunchpadItemsConfig",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "url", "type", "theme", "ariaLabel"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "title": {
        "type": "string",
        "minLength": 2,
        "maxLength": 100
      },
      "url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://"
      },
      "type": {
        "type": "string",
        "enum": ["banner", "compact"]
      },
      "theme": {
        "type": "string",
        "enum": ["teal-blue", "crimson-purple", "telegram", "instagram", "linkedin"]
      },
      "imageSrc": {
        "type": "string"
      },
      "iconName": {
        "type": "string",
        "enum": ["telegram", "instagram", "linkedin"]
      },
      "ariaLabel": {
        "type": "string",
        "minLength": 4
      }
    },
    "additionalProperties": false
  }
}
